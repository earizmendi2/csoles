<odoo>
    <record id="view_bigquery_query_tree" model="ir.ui.view">
        <field name="name">bigquery.connector.query.list</field>
        <field name="model">bigquery.connector.query</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" string="Export Name"/>
                <field name="table_name" string="Model"/>
                <field name="last_sync" string="Last Sync"/>
               <button name="run_query" type="object" string="▶ Run" class="btn-primary"/>
               <button name="hard_refresh"
                        string="▶ Hard Refresh"
                        type="object"
                        class="btn-secondary"
                        confirm="This will reset sync data and re-run the query. Are you sure?" />
          
            </list>
        </field>
    </record>


    <record id="action_bigquery_query" model="ir.actions.act_window">
        <field name="name">BigQuery Queries</field>
        <field name="res_model">bigquery.connector.query</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_bigquery_queries"
              name="BigQuery Connector Pro"
              sequence="10"
              web_icon="odoo_bigquery,static/description/icon.png"          
        />
    <menuitem id="menu_bigquery_query_list"
              name="Manage Queries"
              parent="menu_bigquery_queries"
              action="action_bigquery_query"/>
</odoo>
