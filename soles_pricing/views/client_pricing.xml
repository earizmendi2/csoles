<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="clients_list" model="ir.ui.view"><field name="name">soles.pricing.clients.list</field><field name="model">res.partner</field><field name="arch" type="xml"><list string="Niveles de clientes" create="0" delete="0" editable="bottom" open_form_view="1"><field name="name" string="Cliente" readonly="1"/><field name="vat" optional="show" readonly="1"/><field name="soles_segment_id" string="Nivel del cliente" groups="soles_pricing.group_config" options="{'no_create': True}"/><field name="soles_segment_id" string="Nivel del cliente" readonly="1" groups="sales_team.group_sale_salesman,!soles_pricing.group_config"/><field name="user_id" string="Responsable" optional="show" readonly="1"/><field name="company_id" groups="base.group_multi_company" readonly="1"/><button name="action_soles_client_rules" type="object" string="Reglas del cliente" icon="fa-sliders"/><button name="action_soles_segment_rules" type="object" string="Reglas del nivel" icon="fa-users" invisible="not soles_segment_id"/></list></field></record>
    <record id="clients_search" model="ir.ui.view"><field name="name">soles.pricing.clients.search</field><field name="model">res.partner</field><field name="arch" type="xml"><search><field name="name"/><field name="vat"/><field name="soles_segment_id"/><filter name="commercial" string="Cartera comercial" domain="['|', '|', ('customer_rank', '&gt;', 0), ('soles_segment_id', '!=', False), ('soles_client_rule_ids', '!=', False)]"/><filter name="with_segment" string="Con nivel" domain="[('soles_segment_id', '!=', False)]"/><filter name="without_segment" string="Sin nivel" domain="[('soles_segment_id', '=', False)]"/><group expand="0" string="Agrupar"><filter name="segment" string="Nivel" context="{'group_by': 'soles_segment_id'}"/></group></search></field></record>
    <record id="action_clients" model="ir.actions.act_window"><field name="name">Niveles de clientes</field><field name="res_model">res.partner</field><field name="view_mode">list,form</field><field name="view_id" ref="clients_list"/><field name="search_view_id" ref="clients_search"/><field name="context">{'search_default_commercial': 1, 'default_customer_rank': 1}</field><field name="domain">[('parent_id', '=', False), '|', ('company_id', '=', False), ('company_id', '=', allowed_company_ids[0])]</field></record>
    <record id="partner_conditions_form" model="ir.ui.view"><field name="name">partner.soles.conditions</field><field name="model">res.partner</field><field name="inherit_id" ref="base.view_partner_form"/><field name="arch" type="xml"><xpath expr="//notebook" position="inside"><page string="Condiciones Soles" groups="sales_team.group_sale_salesman"><group><div class="alert alert-info" role="status" colspan="2">El segmento y las reglas particulares definen las condiciones del cliente comercial. Todas las tasas se administran en las reglas.</div><button name="action_soles_client_rules" type="object" string="Gestionar reglas del cliente" class="btn-primary"/><button name="action_soles_segment_rules" type="object" string="Ver reglas del nivel" invisible="not soles_segment_id"/></group><field name="soles_client_rule_ids" readonly="1" domain="[('company_id', '=', context.get('allowed_company_ids', [False])[0])]" context="{'default_scope': 'partner', 'default_partner_id': id}"><list create="0" delete="0"><field name="name"/><field name="stage"/><field name="category_id"/><field name="brand_id"/><field name="product_ids" widget="many2many_tags"/><field name="method"/><field name="discount_pct"/><field name="date_start"/><field name="date_end"/></list></field></page></xpath></field></record>
    <record id="product_variant_form" model="ir.ui.view"><field name="name">product.variant.soles.brand</field><field name="model">product.product</field><field name="inherit_id" ref="product.product_normal_form_view"/><field name="arch" type="xml"><xpath expr="//field[@name='categ_id']" position="after"><field name="soles_brand_id"/></xpath></field></record>
    <record id="segment_form" model="ir.ui.view"><field name="name">soles.pricing.segment.form</field><field name="model">soles.pricing.segment</field><field name="arch" type="xml"><form><sheet><group><field name="name"/><field name="active"/><field name="sequence"/><field name="company_id" groups="base.group_multi_company"/></group><notebook><page string="Reglas del nivel"><field name="company_id" invisible="1"/><field name="rule_ids" context="{'default_scope': 'segment', 'default_segment_id': id, 'default_company_id': company_id}"><list><field name="name"/><field name="stage"/><field name="category_id"/><field name="brand_id"/><field name="method"/><field name="discount_pct"/><field name="min_qty"/><field name="date_start"/><field name="date_end"/></list></field></page></notebook></sheet></form></field></record>
    <record id="rule_search" model="ir.ui.view"><field name="name">soles.pricing.rule.search</field><field name="model">soles.pricing.rule</field><field name="arch" type="xml"><search><field name="name"/><field name="partner_id"/><field name="segment_id"/><field name="category_id"/><field name="brand_id"/><field name="product_ids"/><filter name="base" string="Precios base" domain="[('stage', '=', 'base')]"/><filter name="benefit" string="Beneficios" domain="[('stage', '=', 'benefit')]"/><filter name="general" string="Generales" domain="[('scope', '=', 'general')]"/><filter name="customer" string="Por cliente" domain="[('scope', '=', 'partner')]"/><filter name="archived" string="Archivadas" domain="[('active', '=', False)]"/><group expand="0" string="Agrupar"><filter name="scope" string="Alcance" context="{'group_by':'scope'}"/><filter name="stage" string="Etapa" context="{'group_by':'stage'}"/><filter name="segment" string="Nivel" context="{'group_by':'segment_id'}"/></group></search></field></record>
    <record id="action_rule" model="ir.actions.act_window"><field name="search_view_id" ref="rule_search"/><field name="domain">[('company_id', '=', allowed_company_ids[0])]</field></record>
    <record id="action_authority" model="ir.actions.act_window"><field name="domain">[('company_id', '=', allowed_company_ids[0])]</field></record>
    <record id="action_cost" model="ir.actions.act_window"><field name="domain">[('company_id', '=', allowed_company_ids[0])]</field></record>
    <record id="action_approval" model="ir.actions.act_window"><field name="domain">[('company_id', '=', allowed_company_ids[0])]</field></record>
    <record id="action_segment" model="ir.actions.act_window"><field name="domain">[('company_id', '=', allowed_company_ids[0])]</field></record>
</odoo>
