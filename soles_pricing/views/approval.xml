<odoo>
    <record id="approval_list" model="ir.ui.view"><field name="name">soles.pricing.approval.list</field><field name="model">soles.pricing.approval</field><field name="arch" type="xml"><list create="0" delete="0" decoration-warning="state == 'pending'" decoration-success="state == 'approved'" decoration-muted="state in ('invalid', 'consumed')"><field name="order_id"/><field name="line_id"/><field name="requested_price"/><field name="requested_extra"/><field name="requester_id"/><field name="approver_id"/><field name="state"/><field name="expires_at"/><field name="company_id" groups="base.group_multi_company"/></list></field></record>
    <record id="approval_form" model="ir.ui.view"><field name="name">soles.pricing.approval.form</field><field name="model">soles.pricing.approval</field><field name="arch" type="xml"><form create="0" delete="0"><header><field name="can_decide" invisible="1"/><field name="can_cancel" invisible="1"/><button name="action_approve" type="object" string="Aprobar precio exacto" class="oe_highlight" groups="soles_pricing.group_approver" invisible="not can_decide"/><button name="action_reject" type="object" string="Rechazar" groups="soles_pricing.group_approver" invisible="not can_decide"/><button name="action_check_validity" type="object" string="Verificar vigencia" invisible="state != 'approved'"/><field name="state" widget="statusbar"/></header><sheet><group><group><field name="order_id" readonly="1"/><field name="line_id" readonly="1"/><field name="company_id" readonly="1" groups="base.group_multi_company"/><field name="currency_id" invisible="1"/><field name="requested_price" readonly="1"/><field name="requested_extra" readonly="1"/><field name="cost_snapshot" readonly="1" groups="soles_pricing.group_cost"/><field name="margin_snapshot" readonly="1" groups="soles_pricing.group_cost"/></group><group><field name="requester_id" readonly="1"/><field name="approver_id" readonly="1"/><field name="approved_at" readonly="1"/><field name="expires_at" readonly="1"/><field name="consumed_at" readonly="1"/><field name="effective_valid"/><field name="authority_id" readonly="1"/></group></group><group><field name="reason" readonly="1"/><field name="decision_reason" readonly="state != 'pending'" groups="soles_pricing.group_approver"/><field name="fingerprint" readonly="1" groups="soles_pricing.group_config"/></group></sheet><chatter/></form></field></record>
    <record id="approval_search" model="ir.ui.view"><field name="name">soles.pricing.approval.search</field><field name="model">soles.pricing.approval</field><field name="arch" type="xml"><search><field name="order_id"/><field name="requester_id"/><filter name="pending" string="Pendientes" domain="[('state','=','pending')]"/><filter name="approved" string="Aprobadas" domain="[('state','=','approved')]"/><group expand="0" string="Agrupar"><filter name="by_state" string="Estado" context="{'group_by':'state'}"/></group></search></field></record>
    <record id="action_approval" model="ir.actions.act_window"><field name="name">Autorizaciones extraordinarias</field><field name="res_model">soles.pricing.approval</field><field name="view_mode">list,form</field><field name="context">{'search_default_pending': 1}</field></record>
</odoo>
