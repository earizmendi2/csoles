    <field name="name">Políticas en revisión</field>
    <field name="res_model">soles.pricing.rule</field>
    <field name="view_mode">list,form</field>
    <field name="domain">[('company_id','=',allowed_company_ids[0]), ('state','=','review')]</field>
  </record>
  <menuitem id="menu_publish" name="Publicación" parent="menu_root" action="action_rule_review" sequence="58" groups="soles_pricing.group_publisher"/>
  <record id="approval_routing_form" model="ir.ui.view">
    <field name="name">soles.approval.routing</field>
    <field name="model">soles.pricing.approval</field>
    <field name="inherit_id" ref="soles_pricing.approval_form"/>
    <field name="arch" type="xml">
      <data>
        <xpath expr="//header" position="inside">
          <button name="action_cancel" type="object" string="Cancelar solicitud" invisible="not can_cancel"/>
        </xpath>
        <xpath expr="//sheet" position="inside">
          <group string="Condiciones exactas y responsables">
            <group>
              <field name="name"/>
              <field name="partner_id"/>
              <field name="product_id"/>
              <field name="quantity"/>
              <field name="uom_id"/>
              <field name="base_price"/>
              <field name="preferred_price"/>
            </group>
            <group>
              <field name="route_id"/>
              <field name="reviewer_ids" widget="many2many_tags"/>
              <field name="routing_note"/>
              <field name="company_currency_id"/>
              <field name="discount_amount"/>
              <field name="order_amount"/>
              <field name="consumption_count"/>
              <field name="resolved_at"/>
            </group>
          </group>
        </xpath>
      </data>
    </field>
  </record>
  <record id="approval_routing_list" model="ir.ui.view">
    <field name="name">soles.approval.routing.list</field>
    <field name="model">soles.pricing.approval</field>
    <field name="inherit_id" ref="soles_pricing.approval_list"/>
    <field name="arch" type="xml">
      <data>
        <xpath expr="//list/field[1]" position="before">
          <field name="name"/>
        </xpath>
        <xpath expr="//list" position="inside">
          <field name="reviewer_ids" widget="many2many_tags" optional="show"/>
          <field name="route_id" optional="hide"/>
        </xpath>
      </data>
    </field>
  </record>
  <record id="company_extended_policy" model="ir.ui.view">
    <field name="name">soles.company.extended.policy</field>
    <field name="model">res.company</field>
    <field name="inherit_id" ref="soles_pricing.company_form"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='soles_notify_reviewers']" position="after">
        <field name="soles_allow_benefit"/>
        <field name="soles_revalidate_cost"/>
        <field name="soles_fx_mode"/>
        <field name="soles_brand_field_id"/>
      </xpath>
    </field>
  </record>
  <record id="rule_publication_search" model="ir.ui.view">
    <field name="name">soles.rule.publication.search</field>
    <field name="model">soles.pricing.rule</field>
    <field name="inherit_id" ref="soles_pricing.rule_search"/>
    <field name="arch" type="xml">
      <xpath expr="//search" position="inside">
        <field name="family_id"/>
        <filter name="published" string="Publicadas" domain="[('state','=','published')]"/>
        <filter name="review" string="En revisión" domain="[('state','=','review')]"/>
        <filter name="draft" string="Borradores" domain="[('state','=','draft')]"/>
      </xpath>
    </field>
  </record>
  <record id="action_rule_published" model="ir.actions.act_window">
    <field name="name">Reglas publicadas</field>
    <field name="res_model">soles.pricing.rule</field>
    <field name="view_mode">list,form</field>
    <field name="context">{'search_default_published':1}</field>
    <field name="domain">[('company_id','=',allowed_company_ids[0])]</field>
  </record>
