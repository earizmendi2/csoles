  <record id="cost_publication_list" model="ir.ui.view">
    <field name="name">soles.cost.publication.list</field>
    <field name="model">soles.pricing.cost</field>
    <field name="inherit_id" ref="soles_pricing.cost_list"/>
    <field name="arch" type="xml">
      <data>
        <xpath expr="//list" position="inside">
          <field name="state"/>
          <field name="revision"/>
        </xpath>
      </data>
    </field>
  </record>
  <record id="authority_financial_form" model="ir.ui.view">
    <field name="name">soles.authority.financial</field>
    <field name="model">soles.pricing.authority</field>
    <field name="inherit_id" ref="soles_pricing.authority_form"/>
    <field name="arch" type="xml">
      <data>
        <xpath expr="//field[@name='category_id']" position="before">
          <field name="family_id"/>
          <field name="quote_currency_id"/>
        </xpath>
        <xpath expr="//field[@name='override_floor']" position="after">
          <field name="override_manufacturer" invisible="operation != 'approve'"/>
          <field name="allow_manual_quote" invisible="operation != 'approve'"/>
          <field name="currency_id"/>
          <field name="limit_discount_amount"/>
          <field name="max_discount_amount" invisible="not limit_discount_amount"/>
          <field name="limit_order_amount"/>
          <field name="max_order_amount" invisible="not limit_order_amount"/>
        </xpath>
      </data>
    </field>
  </record>
  <record id="template_commercial_classification" model="ir.ui.view">
    <field name="name">product.template.commercial.classification</field>
    <field name="model">product.template</field>
    <field name="inherit_id" ref="soles_pricing.product_form"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='soles_brand_id']" position="after">
        <field name="soles_family_id"/>
        <field name="soles_product_policy_id"/>
      </xpath>
    </field>
  </record>
  <record id="variant_commercial_classification" model="ir.ui.view">
    <field name="name">product.product.commercial.classification</field>
    <field name="model">product.product</field>
    <field name="inherit_id" ref="soles_pricing.product_variant_form"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='soles_brand_id']" position="after">
        <field name="soles_family_id"/>
        <field name="soles_product_policy_id"/>
      </xpath>
    </field>
  </record>
  <record id="sale_version_form" model="ir.ui.view">
    <field name="name">sale.soles.versions</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="soles_pricing.sale_order_form"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='order_line']/list" position="inside">
        <field name="soles_base_rule_id" optional="hide"/>
        <field name="soles_base_version_id" optional="hide"/>
        <field name="soles_cost_version_id" optional="hide" groups="soles_pricing.group_cost"/>
        <field name="soles_priced_at" optional="hide"/>
        <field name="soles_approval_status" optional="show"/>
      </xpath>
    </field>
  </record>
