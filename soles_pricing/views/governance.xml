          <button name="action_deactivate" type="object" string="Retirar" groups="soles_pricing.group_publisher" invisible="state != 'published'"/>
          <field name="state" widget="statusbar"/>
        </header>
        <sheet>
          <group>
            <field readonly="state in ('published', 'inactive')" name="name"/>
            <field readonly="state in ('published', 'inactive')" name="company_id"/>
            <field readonly="state in ('published', 'inactive')" name="currency_id"/>
            <field readonly="state in ('published', 'inactive')" name="company_currency_id"/>
            <field readonly="state in ('published', 'inactive')" name="rate"/>
            <field readonly="state in ('published', 'inactive')" name="date_start"/>
            <field readonly="state in ('published', 'inactive')" name="date_end"/>
            <field readonly="state in ('published', 'inactive')" name="source_reference"/>
          </group>
          <group string="Publicación">
            <field name="justification" readonly="state in ('published', 'inactive')"/>
            <field name="revision"/>
            <field name="publisher_id"/>
            <field name="published_at"/>
            <field name="version_id"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>
