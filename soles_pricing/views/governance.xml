    <field name="model">soles.pricing.rule</field>
    <field name="inherit_id" ref="soles_pricing.rule_form"/>
    <field name="arch" type="xml">
      <data>
        <xpath expr="//header" position="inside">
          <button name="action_submit" type="object" string="Enviar a revisión" invisible="state != 'draft'"/>
          <button name="action_return_draft" type="object" string="Regresar a borrador" invisible="state != 'review'"/>
