<odoo>
    <record id="segment_company" model="ir.rule"><field name="name">Segmentos por compañía</field><field name="model_id" ref="model_soles_pricing_segment"/><field name="domain_force">[('company_id','in',company_ids)]</field></record>
    <record id="rule_company" model="ir.rule"><field name="name">Reglas por compañía</field><field name="model_id" ref="model_soles_pricing_rule"/><field name="domain_force">[('company_id','in',company_ids)]</field></record>
    <record id="authority_company" model="ir.rule"><field name="name">Facultades por compañía</field><field name="model_id" ref="model_soles_pricing_authority"/><field name="domain_force">[('company_id','in',company_ids)]</field></record>
    <record id="cost_company" model="ir.rule"><field name="name">Costos por compañía</field><field name="model_id" ref="model_soles_pricing_cost"/><field name="domain_force">[('company_id','in',company_ids)]</field></record>
    <record id="approval_company" model="ir.rule"><field name="name">Autorizaciones por compañía</field><field name="model_id" ref="model_soles_pricing_approval"/><field name="domain_force">[('company_id','in',company_ids)]</field></record>
    <record id="approval_owner" model="ir.rule"><field name="name">Autorizaciones de cotizaciones propias</field><field name="model_id" ref="model_soles_pricing_approval"/><field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/><field name="domain_force">['|', ('order_id.user_id','=',user.id), ('order_id.user_id','=',False)]</field></record>
    <record id="approval_all" model="ir.rule"><field name="name">Autorizaciones de todas las cotizaciones</field><field name="model_id" ref="model_soles_pricing_approval"/><field name="groups" eval="[(4, ref('sales_team.group_sale_salesman_all_leads'))]"/><field name="domain_force">[(1,'=',1)]</field></record>
    <record id="simulator_company" model="ir.rule"><field name="name">Simulador por compañía</field><field name="model_id" ref="model_soles_pricing_simulator"/><field name="domain_force">[('company_id','in',company_ids)]</field></record>
<record id="family_company" model="ir.rule"><field name="name">family por compañía</field><field name="model_id" ref="model_soles_pricing_family"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
<record id="product_policy_company" model="ir.rule"><field name="name">product_policy por compañía</field><field name="model_id" ref="model_soles_pricing_product_policy"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
<record id="fx_company" model="ir.rule"><field name="name">fx por compañía</field><field name="model_id" ref="model_soles_pricing_fx"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
<record id="limit_company" model="ir.rule"><field name="name">limit por compañía</field><field name="model_id" ref="model_soles_pricing_limit"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
<record id="precedence_company" model="ir.rule"><field name="name">precedence por compañía</field><field name="model_id" ref="model_soles_pricing_precedence"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
<record id="route_company" model="ir.rule"><field name="name">route por compañía</field><field name="model_id" ref="model_soles_pricing_route"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
<record id="version_company" model="ir.rule"><field name="name">version por compañía</field><field name="model_id" ref="model_soles_pricing_version"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
<record id="audit_company" model="ir.rule"><field name="name">audit por compañía</field><field name="model_id" ref="model_soles_pricing_audit"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
<record id="version_cost_hide" model="ir.rule"><field name="name">Ocultar costos en version</field><field name="model_id" ref="model_soles_pricing_version"/><field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/><field name="domain_force">[('model_name','!=','soles.pricing.cost')]</field></record>
 <record id="version_cost_show" model="ir.rule"><field name="name">Consultar costos en version</field><field name="model_id" ref="model_soles_pricing_version"/><field name="groups" eval="[(4, ref('soles_pricing.group_cost'))]"/><field name="domain_force">[(1,'=',1)]</field></record>
<record id="audit_cost_hide" model="ir.rule"><field name="name">Ocultar costos en audit</field><field name="model_id" ref="model_soles_pricing_audit"/><field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/><field name="domain_force">[('model_name','!=','soles.pricing.cost')]</field></record>
 <record id="audit_cost_show" model="ir.rule"><field name="name">Consultar costos en audit</field><field name="model_id" ref="model_soles_pricing_audit"/><field name="groups" eval="[(4, ref('soles_pricing.group_cost'))]"/><field name="domain_force">[(1,'=',1)]</field></record>
</odoo>
