<odoo>
    <record id="module_category_pricing" model="ir.module.category"><field name="name">Soles · Precios</field><field name="sequence">25</field></record>
    <record id="group_seller" model="res.groups"><field name="name">Rol vendedor</field><field name="category_id" ref="module_category_pricing"/><field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/></record>
    <record id="group_manager" model="res.groups"><field name="name">Rol gerente</field><field name="category_id" ref="module_category_pricing"/><field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman_all_leads'))]"/></record>
    <record id="group_special_manager" model="res.groups"><field name="name">Rol gerente especial</field><field name="category_id" ref="module_category_pricing"/><field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman_all_leads'))]"/></record>
    <record id="group_cost" model="res.groups"><field name="name">Consultar costos y márgenes</field><field name="category_id" ref="module_category_pricing"/></record>
    <record id="group_approver" model="res.groups"><field name="name">Aprobar extraordinarios</field><field name="category_id" ref="module_category_pricing"/><field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman_all_leads')), (4, ref('group_cost'))]"/></record>
    <record id="group_config" model="res.groups"><field name="name">Administrar precios</field><field name="category_id" ref="module_category_pricing"/><field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman_all_leads')), (4, ref('group_cost')), (4, ref('base.group_partner_manager')), (4, ref('product.group_product_manager'))]"/></record>
    <record id="group_cost_editor" model="res.groups"><field name="name">Preparar costos comerciales</field><field name="category_id" ref="module_category_pricing"/><field name="implied_ids" eval="[(4, ref('group_cost')), (4, ref('sales_team.group_sale_salesman_all_leads'))]"/></record>
    <record id="group_publisher" model="res.groups"><field name="name">Publicar políticas y costos</field><field name="category_id" ref="module_category_pricing"/><field name="implied_ids" eval="[(4, ref('group_cost')), (4, ref('sales_team.group_sale_salesman_all_leads'))]"/></record>
</odoo>
