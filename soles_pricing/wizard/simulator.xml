<odoo>
    <record id="simulator_form" model="ir.ui.view"><field name="name">soles.pricing.simulator.form</field><field name="model">soles.pricing.simulator</field><field name="arch" type="xml"><form string="Simulador Soles"><group><group><field name="company_id" groups="base.group_multi_company"/><field name="partner_id"/><field name="product_id"/><field name="quantity"/><field name="uom_id"/><field name="pricelist_id"/><field name="currency_id" readonly="1"/><field name="fiscal_position_id"/><field name="preview_rule_id" groups="soles_pricing.group_config,soles_pricing.group_publisher"/><field name="date"/><field name="user_id"/></group><group><field name="use_requested"/><field name="requested_price" invisible="not use_requested"/><field name="preferred"/><field name="min_price"/><field name="cost_result" groups="soles_pricing.group_cost"/><field name="margin_result" groups="soles_pricing.group_cost"/><field name="result"/></group></group><footer><button name="action_simulate" type="object" string="Simular" class="btn-primary"/><button string="Cerrar" special="cancel"/></footer></form></field></record>
