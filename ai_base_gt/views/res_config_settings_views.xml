<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.ai.base</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='user_default_rights']" position="before">
                <block title="AI" name="ai">
                    <setting string="RAG Server URL">
                        <field name="rag_server_url"/>
                    </setting>
                    <setting string="RAG Server Token">
                        <field name="rag_server_token"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
