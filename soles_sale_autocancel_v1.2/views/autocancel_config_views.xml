<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_soles_autocancel_config_form" model="ir.ui.view">
        <field name="name">soles.autocancel.config.form</field>
        <field name="model">soles.autocancel.config</field>
        <field name="arch" type="xml">
            <form string="Configuración de Cancelación Automática">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="activo"/>
                            <field name="modo_prueba"/>
                            <field name="notificar_por_chatter"/>
                        </group>
                        <group>
                            <field name="dias_limite"/>
                            <field name="fecha_corte_creacion"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notificaciones" name="notificaciones">
                            <group>
                                <field name="canal_notificacion_id"/>
                                <field name="notificar_usuario_ids" widget="many2many_tags"/>
                                <field name="notificar_grupo_ids" widget="many2many_tags"/>
                            </group>
                        </page>
                        <page string="Clientes excluidos" name="clientes_excluidos">
                            <p class="text-muted">
                                Los pedidos de estos clientes nunca se cancelarán
                                automáticamente, sin importar cuántos días lleven
                                sin facturar.
                            </p>
                            <field name="clientes_excluidos_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="vat"/>
                                    <field name="phone"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_soles_autocancel_config_tree" model="ir.ui.view">
        <field name="name">soles.autocancel.config.tree</field>
        <field name="model">soles.autocancel.config</field>
        <field name="arch" type="xml">
            <list string="Configuración de Cancelación Automática">
                <field name="name"/>
                <field name="activo"/>
                <field name="dias_limite"/>
                <field name="modo_prueba"/>
            </list>
        </field>
    </record>

    <record id="action_soles_autocancel_config" model="ir.actions.act_window">
        <field name="name">Configuración de Cancelación Automática</field>
        <field name="res_model">soles.autocancel.config</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
