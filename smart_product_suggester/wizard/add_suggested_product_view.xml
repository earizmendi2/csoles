<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="add_suggested_product_form" model="ir.ui.view">
            <field name="name">add.suggested.product.form</field>
            <field name="model">add.suggested.product.wizard</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <field name="suggested_product_ids">
                            <tree create="false" editable="top">
                                <field name="product_id" readonly="1"/>
                                <field name="quantity"/>
                                <field name="price_unit" readonly="1"/>
                            </tree>
                        </field>
                        <footer>
                            <button name="add" string="Add" type="object" class="btn-primary"/>
                            <button string="Cancel" class="btn-secondary" special="cancel"/>
                        </footer>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>