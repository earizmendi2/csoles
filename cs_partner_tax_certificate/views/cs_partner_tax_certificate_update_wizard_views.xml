<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_update_from_sat_wizard_form" model="ir.ui.view">
        <field name="name">cs.partner.tax.certificate.update.wizard.form</field>
        <field name="model">cs.partner.tax.certificate.update.wizard</field>
        <field name="arch" type="xml">
            <form string="Actualizar datos fiscales desde el SAT">

                <header>
                    <field name="step"
                           widget="statusbar"
                           statusbar_visible="fetch,review"
                           readonly="1"/>
                </header>

                <sheet>

                    <!-- ══ PASO 1: presentación ══════════════════════════════ -->
                    <div invisible="step != 'fetch'">

                        <div class="text-center py-4">
                            <i class="fa fa-refresh fa-5x text-primary" title="Actualizar"/>
                            <h3 class="mt-3 mb-1">Actualizar desde el SAT</h3>
                            <p class="text-muted" style="max-width:540px; margin:0 auto 24px;">
                                Se consultará la URL de verificación almacenada en el contacto
                                para obtener los datos fiscales más recientes del SAT.
                            </p>
                        </div>

                        <div class="d-flex justify-content-center">
                            <div style="min-width:460px;">
                                <group>
                                    <field name="partner_id" readonly="1"/>
                                </group>

                                <div class="alert alert-warning mt-3" role="alert">
                                    <i class="fa fa-info-circle me-2" title="Consentimiento"/>
                                    <strong>Aviso de consentimiento</strong>
                                    <ul class="mb-0 mt-2">
                                        <li>
                                            Esta acción consultará la URL oficial del SAT
                                            incluida en el código QR de la Constancia de
                                            Situación Fiscal.
                                        </li>
                                        <li>
                                            El archivo PDF no será enviado a servidores de
                                            Cusoft ni a servicios externos distintos al SAT.
                                        </li>
                                        <li>
                                            La consulta se realizará desde su servidor de
                                            Odoo hacia <strong>siat.sat.gob.mx</strong>.
                                        </li>
                                    </ul>
                                </div>

                                <group class="mt-2">
                                    <field name="sat_consent_accepted"/>
                                </group>

                                <div class="alert alert-info mt-2" role="alert">
                                    <i class="fa fa-shield me-2" title="Seguridad"/>
                                    <strong>Seguridad:</strong>
                                    Solo se realizan peticiones HTTPS al dominio oficial
                                    del SAT. No se envían datos del contacto al SAT.
                                </div>

                                <div class="alert alert-warning mt-2" role="alert">
                                    <i class="fa fa-clock-o me-2" title="Tiempo de espera"/>
                                    La consulta puede tardar hasta 20 segundos dependiendo
                                    de la disponibilidad del portal del SAT.
                                </div>
                            </div>
                        </div>

                    </div>

                    <!-- ══ PASO 2: comparación de datos ══════════════════════ -->
                    <div invisible="step != 'review'">

                        <field name="can_apply_mx_fiscal_regime" invisible="1"/>
                        <field name="has_sat_address" invisible="1"/>

                        <div class="oe_title mb-3">
                            <h2 class="mb-0">
                                <i class="fa fa-balance-scale text-primary me-2" title="Comparación"/>
                                Comparación con datos del SAT
                            </h2>
                            <small class="text-muted">
                                Seleccione los campos a actualizar y presione
                                <strong>Aplicar cambios</strong>.
                            </small>
                        </div>
                        <hr class="mt-1 mb-3"/>

                        <!-- Aviso del SAT si no se extrajeron datos -->
                        <div class="alert alert-warning mb-3"
                             role="alert"
                             invisible="not sat_warning">
                            <i class="fa fa-exclamation-triangle me-2" title="Advertencia"/>
                            <field name="sat_warning" nolabel="1" readonly="1"/>
                        </div>

                        <!-- Estatus en el padrón (informativo) -->
                        <div class="mb-3" invisible="not sat_padron_status">
                            <div class="d-flex align-items-center gap-2">
                                <i class="fa fa-id-card-o fa-lg text-muted" title="Identificación"/>
                                <span class="text-muted">Estatus en el Padrón del SAT:</span>
                                <field name="sat_padron_status"
                                       nolabel="1"
                                       readonly="1"
                                       class="fw-bold text-success"/>
                            </div>
                        </div>

                        <!-- Tabla comparativa: Dato · Valor actual · SAT · ✓ -->
                        <table class="table table-bordered table-sm align-middle mb-3">
                            <thead class="table-light">
                                <tr>
                                    <th style="width:22%">Campo</th>
                                    <th style="width:32%">Valor actual</th>
                                    <th style="width:38%">Valor del SAT</th>
                                    <th class="text-center" style="width:8%">Actualizar</th>
                                </tr>
                            </thead>
                            <tbody>
                                <!-- Razón Social -->
                                <tr>
                                    <td class="fw-semibold">Razón Social / Nombre</td>
                                    <td class="text-muted">
                                        <field name="current_name" nolabel="1" readonly="1"/>
                                    </td>
                                    <td>
                                        <field name="sat_name" nolabel="1" readonly="1"
                                               class="fw-semibold"/>
                                    </td>
                                    <td class="text-center">
                                        <field name="apply_name" nolabel="1"
                                               invisible="not sat_name"/>
                                    </td>
                                </tr>
                                <!-- RFC / NIF -->
                                <tr>
                                    <td class="fw-semibold">NIF / RFC</td>
                                    <td class="text-muted">
                                        <field name="current_vat" nolabel="1" readonly="1"/>
                                    </td>
                                    <td>
                                        <field name="sat_rfc" nolabel="1" readonly="1"
                                               class="fw-semibold font-monospace"/>
                                    </td>
                                    <td class="text-center">
                                        <field name="apply_vat" nolabel="1"
                                               invisible="not sat_rfc"/>
                                    </td>
                                </tr>
                                <!-- Domicilio fiscal (grupo) -->
                                <tr invisible="not has_sat_address">
                                    <td class="fw-semibold">Domicilio fiscal</td>
                                    <td class="text-muted" colspan="1">—</td>
                                    <td class="text-muted">—</td>
                                    <td class="text-center">
                                        <field name="apply_address" nolabel="1"/>
                                    </td>
                                </tr>
                                <tr invisible="not has_sat_address">
                                    <td class="ps-4 text-muted">Calle (nombre vialidad)</td>
                                    <td class="text-muted">
                                        <field name="current_street_name" nolabel="1" readonly="1"/>
                                    </td>
                                    <td>
                                        <field name="sat_street_name" nolabel="1" readonly="1"
                                               class="fw-semibold"/>
                                    </td>
                                    <td/>
                                </tr>
                                <tr invisible="not has_sat_address">
                                    <td class="ps-4 text-muted">Número exterior</td>
                                    <td class="text-muted">
                                        <field name="current_street_number" nolabel="1" readonly="1"/>
                                    </td>
                                    <td>
                                        <field name="sat_street_number" nolabel="1" readonly="1"
                                               class="fw-semibold"/>
                                    </td>
                                    <td/>
                                </tr>
                                <tr invisible="not has_sat_address">
                                    <td class="ps-4 text-muted">Número interior</td>
                                    <td class="text-muted">
                                        <field name="current_street_number2" nolabel="1" readonly="1"/>
                                    </td>
                                    <td>
                                        <field name="sat_street_number2" nolabel="1" readonly="1"
                                               class="fw-semibold"/>
                                    </td>
                                    <td/>
                                </tr>
                                <tr invisible="not has_sat_address">
                                    <td class="ps-4 text-muted">Colonia</td>
                                    <td class="text-muted">
                                        <field name="current_colony" nolabel="1" readonly="1"/>
                                    </td>
                                    <td>
                                        <field name="sat_colony" nolabel="1" readonly="1"
                                               class="fw-semibold"/>
                                    </td>
                                    <td/>
                                </tr>
                                <tr invisible="not has_sat_address">
                                    <td class="ps-4 text-muted">Localidad</td>
                                    <td class="text-muted">
                                        <field name="current_locality" nolabel="1" readonly="1"/>
                                    </td>
                                    <td>
                                        <field name="sat_locality" nolabel="1" readonly="1"
                                               class="fw-semibold"/>
                                    </td>
                                    <td/>
                                </tr>
                                <tr invisible="not has_sat_address">
                                    <td class="ps-4 text-muted">Municipio / Delegación</td>
                                    <td class="text-muted">
                                        <field name="current_city" nolabel="1" readonly="1"/>
                                    </td>
                                    <td>
                                        <field name="sat_city" nolabel="1" readonly="1"
                                               class="fw-semibold"/>
                                    </td>
                                    <td/>
                                </tr>
                                <tr invisible="not has_sat_address">
                                    <td class="ps-4 text-muted">Entidad federativa</td>
                                    <td class="text-muted">
                                        <field name="current_state" nolabel="1" readonly="1"/>
                                    </td>
                                    <td>
                                        <field name="sat_state" nolabel="1" readonly="1"
                                               class="fw-semibold"/>
                                    </td>
                                    <td/>
                                </tr>
                                <tr invisible="not has_sat_address">
                                    <td class="ps-4 text-muted">Código Postal</td>
                                    <td class="text-muted">
                                        <field name="current_zip" nolabel="1" readonly="1"/>
                                    </td>
                                    <td>
                                        <field name="sat_zip" nolabel="1" readonly="1"
                                               class="fw-semibold font-monospace"/>
                                    </td>
                                    <td/>
                                </tr>
                                <tr invisible="not has_sat_address">
                                    <td class="ps-4 text-muted">Correo electrónico</td>
                                    <td class="text-muted">
                                        <field name="current_email" nolabel="1" readonly="1"/>
                                    </td>
                                    <td>
                                        <field name="sat_email" nolabel="1" readonly="1"
                                               class="fw-semibold"/>
                                    </td>
                                    <td/>
                                </tr>
                                <!-- Régimen fiscal (solo si existe campo EDI México) -->
                                <tr invisible="not can_apply_mx_fiscal_regime">
                                    <td class="fw-semibold">Régimen Fiscal</td>
                                    <td class="text-muted">
                                        <field name="current_fiscal_regime" nolabel="1" readonly="1"/>
                                    </td>
                                    <td>
                                        <field name="sat_fiscal_regime_text" nolabel="1" readonly="1"
                                               class="fw-semibold"/>
                                    </td>
                                    <td class="text-center">
                                        <field name="apply_fiscal_regime" nolabel="1"
                                               invisible="not sat_fiscal_regime"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <!-- Datos adicionales del SAT (solo lectura) -->
                        <group string="Información adicional del SAT (no se guarda)" col="2">
                            <field name="sat_start_date" readonly="1"
                                   invisible="not sat_start_date"/>
                            <field name="sat_last_update" readonly="1"
                                   invisible="not sat_last_update"/>
                        </group>

                        <!-- Aviso antes de confirmar -->
                        <div class="alert alert-warning mt-3" role="alert">
                            <i class="fa fa-exclamation-triangle me-2" title="Advertencia"/>
                            <strong>Importante:</strong>
                            Los cambios seleccionados se aplicarán de inmediato al contacto.
                            Verifique que los datos fiscales sean correctos antes de confirmar,
                            especialmente si el contacto tiene facturas emitidas.
                        </div>

                    </div>

                </sheet>

                <footer>

                    <button name="action_fetch_from_sat"
                            string="  Consultar SAT"
                            type="object"
                            class="btn-primary"
                            icon="fa-refresh"
                            invisible="step != 'fetch' or not sat_consent_accepted"/>

                    <button name="action_apply_changes"
                            string="  Aplicar cambios seleccionados"
                            type="object"
                            class="btn-success"
                            icon="fa-check"
                            invisible="step != 'review'"/>

                    <button string="Cancelar"
                            class="btn-link"
                            special="cancel"/>

                </footer>

            </form>
        </field>
    </record>

</odoo>
