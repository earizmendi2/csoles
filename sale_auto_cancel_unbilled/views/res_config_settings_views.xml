<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_sale_auto_cancel" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.sale.auto.cancel</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale_management.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='online_signature']" position="after">
                <setting id="sale_auto_cancel_setting"
                         string="Cancelación automática de órdenes sin facturar"
                         help="Cancela automáticamente las órdenes confirmadas que no tengan ninguna factura después de X días desde su creación. 0 desactiva esta función.">
                    <field name="sale_auto_cancel_days"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
