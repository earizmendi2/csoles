<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="module_category_soles_treasury" model="ir.module.category">
        <field name="name">Tesorería Soles</field>
        <field name="description">Gestión de solicitudes y programación de pagos.</field>
        <field name="sequence">35</field>
    </record>

    <record id="group_payment_request_user" model="res.groups">
        <field name="name">Solicitante de pagos</field>
        <field name="category_id" ref="module_category_soles_treasury"/>
    </record>

    <record id="group_treasury_user" model="res.groups">
        <field name="name">Tesorería</field>
        <field name="category_id" ref="module_category_soles_treasury"/>
        <field name="implied_ids" eval="[(4, ref('group_payment_request_user'))]"/>
    </record>

    <record id="group_treasury_manager" model="res.groups">
        <field name="name">Responsable de Tesorería</field>
        <field name="category_id" ref="module_category_soles_treasury"/>
        <field name="implied_ids" eval="[(4, ref('group_treasury_user'))]"/>
    </record>

    <record id="group_finance_manager" model="res.groups">
        <field name="name">Administración y Finanzas</field>
        <field name="category_id" ref="module_category_soles_treasury"/>
        <field name="implied_ids" eval="[(4, ref('group_treasury_manager'))]"/>
    </record>

    <!-- Reglas globales multicompañía -->
    <record id="rule_payment_request_company" model="ir.rule">
        <field name="name">Solicitudes de pago: compañía</field>
        <field name="model_id" ref="model_soles_payment_request"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_treasury_team_company" model="ir.rule">
        <field name="name">Equipos Tesorería: compañía</field>
        <field name="model_id" ref="model_soles_treasury_team"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_payment_schedule_company" model="ir.rule">
        <field name="name">Calendario de pagos: compañía</field>
        <field name="model_id" ref="model_soles_treasury_payment_schedule"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('team_id.company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_recurrence_company" model="ir.rule">
        <field name="name">Pagos recurrentes: compañía</field>
        <field name="model_id" ref="model_soles_payment_recurrence"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_treasury_config_company" model="ir.rule">
        <field name="name">Configuración Tesorería: compañía</field>
        <field name="model_id" ref="model_soles_treasury_config"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <!-- Solicitante: solo sus solicitudes -->
    <record id="rule_payment_request_own" model="ir.rule">
        <field name="name">Solicitante: sus solicitudes</field>
        <field name="model_id" ref="model_soles_payment_request"/>
        <field name="groups" eval="[(4, ref('group_payment_request_user'))]"/>
        <field name="domain_force">[('requester_id', '=', user.id)]</field>
    </record>

    <!-- Tesorería: todas las solicitudes de sus compañías -->
    <record id="rule_payment_request_treasury" model="ir.rule">
        <field name="name">Tesorería: todas las solicitudes</field>
        <field name="model_id" ref="model_soles_payment_request"/>
        <field name="groups" eval="[(4, ref('group_treasury_user'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
