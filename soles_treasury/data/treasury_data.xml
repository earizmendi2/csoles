<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">
    <record id="seq_payment_request" model="ir.sequence">
        <field name="name">Solicitud de Pago</field>
        <field name="code">soles.payment.request</field>
        <field name="prefix">PAY/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="cron_payment_request_alerts" model="ir.cron">
        <field name="name">Tesorería: Alertas de pagos</field>
        <field name="model_id" ref="model_soles_payment_request"/>
        <field name="state">code</field>
        <field name="code">model._cron_process_payment_alerts()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

    <record id="cron_payment_recurrences" model="ir.cron">
        <field name="name">Tesorería: Pagos recurrentes</field>
        <field name="model_id" ref="model_soles_payment_recurrence"/>
        <field name="state">code</field>
        <field name="code">model._cron_process_recurrences()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
