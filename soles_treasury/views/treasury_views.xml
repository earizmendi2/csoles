<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Solicitudes de pago -->
    <record id="view_payment_request_list" model="ir.ui.view">
        <field name="name">soles.payment.request.list</field>
        <field name="model">soles.payment.request</field>
        <field name="arch" type="xml">
            <list string="Solicitudes de Pago"
                  decoration-danger="state == 'overdue'"
                  decoration-warning="state == 'due'"
                  decoration-success="state == 'paid' or state == 'closed'"
                  decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="requester_id"/>
                <field name="partner_id"/>
                <field name="origin_type" widget="badge"
                       decoration-info="origin_type == 'approval'"
                       decoration-warning="origin_type == 'extraordinary'"/>
                <field name="amount" sum="Total"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="requested_payment_date"/>
                <field name="scheduled_payment_date"/>
                <field name="treasury_responsible_id"/>
                <field name="state" widget="badge"
                       decoration-muted="state in ['draft', 'cancelled']"
                       decoration-info="state == 'submitted'"
                       decoration-primary="state == 'validated'"
                       decoration-warning="state in ['scheduled', 'due']"
                       decoration-danger="state == 'overdue'"
                       decoration-success="state in ['paid', 'closed']"/>
                <field name="overdue" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_payment_request_form" model="ir.ui.view">
        <field name="name">soles.payment.request.form</field>
        <field name="model">soles.payment.request</field>
        <field name="arch" type="xml">
            <form string="Solicitud de Pago">
                <header>
                    <button name="action_submit" string="Enviar" type="object" class="oe_highlight"
                            invisible="state not in ['draft', 'returned']"/>
                    <button name="action_validate" string="Validar" type="object" class="oe_highlight"
                            groups="soles_treasury.group_treasury_user" invisible="state != 'submitted'"/>
                    <button name="action_schedule" string="Programar pago" type="object" class="oe_highlight"
                            groups="soles_treasury.group_treasury_user" invisible="state != 'validated'"/>
                    <button name="action_mark_paid" string="Marcar pagado" type="object" class="oe_highlight"
                            groups="soles_treasury.group_treasury_user" invisible="state not in ['scheduled', 'due', 'overdue']"/>
                    <button name="action_close" string="Cerrar" type="object"
                            groups="soles_treasury.group_finance_manager" invisible="state != 'paid'"/>
                    <button name="action_return" string="Devolver" type="object"
                            groups="soles_treasury.group_treasury_user"
                            invisible="state not in ['submitted', 'validated', 'scheduled', 'due', 'overdue']"/>
                    <button name="action_cancel" string="Cancelar" type="object"
                            invisible="state in ['paid', 'closed', 'cancelled']"/>
                    <field name="state" widget="statusbar" readonly="1"
                           statusbar_visible="draft,submitted,validated,scheduled,due,overdue,paid,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_approval" type="object" class="oe_stat_button"
                                icon="fa-check-square" invisible="not approval_request_id">
                            <div class="o_stat_info"><span class="o_stat_text">Aprobación</span></div>
                        </button>
                    </div>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>

                    <field name="allowed_approval_category_ids" invisible="1"/>
                    <field name="overdue" invisible="1"/>

                    <group>
                        <group string="Solicitud">
                            <field name="origin_type" readonly="state not in ['draft', 'returned']"/>
                            <field name="requester_id" readonly="state not in ['draft', 'returned']"/>
                            <field name="department_id" readonly="state not in ['draft', 'returned']"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
                            <field name="priority" widget="priority"/>
                        </group>
                        <group string="Proveedor">
                            <field name="partner_id" readonly="state not in ['draft', 'returned']"/>
                            <field name="reference" readonly="state not in ['draft', 'returned']"/>
                            <field name="amount" readonly="state not in ['draft', 'returned']"/>
                            <field name="currency_id" readonly="state not in ['draft', 'returned']"/>
                        </group>
                    </group>

                    <group string="Aprobación vinculada" invisible="origin_type != 'approval'">
                        <group>
                            <field name="approval_request_id"
                                   domain="[('category_id', 'in', allowed_approval_category_ids), ('request_status', '=', 'approved')]"
                                   readonly="state not in ['draft', 'returned']"/>
                            <field name="approval_category_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="approval_amount" readonly="1"/>
                            <field name="approval_available_amount" readonly="1"/>
                        </group>
                    </group>

                    <group string="Pago extraordinario" invisible="origin_type != 'extraordinary'">
                        <field name="extraordinary_type" readonly="state not in ['draft', 'returned']"/>
                        <field name="extraordinary_reason" readonly="state not in ['draft', 'returned']"/>
                    </group>

                    <group string="Concepto">
                        <field name="description" nolabel="1" readonly="state not in ['draft', 'returned']"/>
                    </group>

                    <group string="Factura y documentación">
                        <group>
                            <field name="invoice_number"/>
                            <field name="invoice_date"/>
                            <field name="invoice_due_date"/>
                        </group>
                        <group>
                            <field name="invoice_pdf" filename="invoice_pdf_filename"/>
                            <field name="invoice_pdf_filename" invisible="1"/>
                            <field name="invoice_xml" filename="invoice_xml_filename"/>
                            <field name="invoice_xml_filename" invisible="1"/>
                        </group>
                    </group>

                    <group string="Otros documentos">
                        <field name="attachment_ids" widget="many2many_binary" nolabel="1"/>
                    </group>

                    <group string="Programación de pago">
                        <group>
                            <field name="request_date"/>
                            <field name="requested_payment_date"/>
                            <field name="scheduled_payment_date" groups="soles_treasury.group_treasury_user"/>
                            <field name="actual_payment_date" readonly="1"/>
                        </group>
                        <group>
                            <field name="team_id" groups="soles_treasury.group_treasury_user"
                                   domain="[('company_id', '=', company_id)]"/>
                            <field name="team_payment_schedule_summary" readonly="1"
                                   groups="soles_treasury.group_treasury_user"
                                   invisible="not team_id"/>
                            <field name="treasury_responsible_id" groups="soles_treasury.group_treasury_user"/>
                            <field name="recurrence_id" readonly="1" invisible="not recurrence_id"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_payment_request_calendar" model="ir.ui.view">
        <field name="name">soles.payment.request.calendar</field>
        <field name="model">soles.payment.request</field>
        <field name="arch" type="xml">
            <calendar string="Calendario de Pagos" date_start="scheduled_payment_date" color="partner_id" mode="month">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="amount"/>
                <field name="currency_id"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <record id="view_payment_request_search" model="ir.ui.view">
        <field name="name">soles.payment.request.search</field>
        <field name="model">soles.payment.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="requester_id"/>
                <field name="treasury_responsible_id"/>
                <field name="approval_request_id"/>
                <filter name="submitted" string="Por validar" domain="[('state', '=', 'submitted')]"/>
                <filter name="scheduled" string="Programados" domain="[('state', '=', 'scheduled')]"/>
                <filter name="due" string="Por pagar hoy" domain="[('state', '=', 'due')]"/>
                <filter name="overdue" string="Atrasados" domain="[('state', '=', 'overdue')]"/>
                <filter name="paid" string="Pagados" domain="[('state', 'in', ['paid', 'closed'])]"/>
                <filter name="extraordinary" string="Extraordinarios" domain="[('origin_type', '=', 'extraordinary')]"/>
                <separator/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_state" string="Estado" context="{'group_by': 'state'}"/>
                    <filter name="group_partner" string="Proveedor" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_responsible" string="Responsable" context="{'group_by': 'treasury_responsible_id'}"/>
                    <filter name="group_team" string="Equipo" context="{'group_by': 'team_id'}"/>
                    <filter name="group_month" string="Mes de pago" context="{'group_by': 'scheduled_payment_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_payment_requests" model="ir.actions.act_window">
        <field name="name">Solicitudes de Pago</field>
        <field name="res_model">soles.payment.request</field>
        <field name="view_mode">list,calendar,form</field>
        <field name="search_view_id" ref="view_payment_request_search"/>
    </record>

    <record id="action_my_payment_requests" model="ir.actions.act_window">
        <field name="name">Mis Solicitudes</field>
        <field name="res_model">soles.payment.request</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('requester_id', '=', uid)]</field>
    </record>

    <record id="action_payment_calendar" model="ir.actions.act_window">
        <field name="name">Calendario de Pagos</field>
        <field name="res_model">soles.payment.request</field>
        <field name="view_mode">calendar,list,form</field>
        <field name="domain">[('scheduled_payment_date', '!=', False)]</field>
        <field name="search_view_id" ref="view_payment_request_search"/>
    </record>

    <!-- Pagos recurrentes -->
    <record id="view_payment_recurrence_list" model="ir.ui.view">
        <field name="name">soles.payment.recurrence.list</field>
        <field name="model">soles.payment.recurrence</field>
        <field name="arch" type="xml">
            <list decoration-muted="not active">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="estimated_amount"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="frequency"/>
                <field name="next_date"/>
                <field name="responsible_id"/>
                <field name="generation_mode"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_payment_recurrence_form" model="ir.ui.view">
        <field name="name">soles.payment.recurrence.form</field>
        <field name="model">soles.payment.recurrence</field>
        <field name="arch" type="xml">
            <form string="Pago Recurrente">
                <header>
                    <button name="action_generate_payment_request" string="Generar solicitud ahora" type="object" class="oe_highlight"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_payment_requests" type="object" class="oe_stat_button" icon="fa-money">
                            <field name="payment_request_count" widget="statinfo" string="Solicitudes"/>
                        </button>
                    </div>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="description"/>
                            <field name="estimated_amount"/>
                            <field name="currency_id"/>
                            <field name="extraordinary_type"/>
                        </group>
                        <group>
                            <field name="team_id" domain="[('company_id', '=', company_id)]"/>
                            <field name="responsible_id"/>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Recurrencia">
                        <group>
                            <field name="frequency"/>
                            <field name="custom_interval" invisible="frequency != 'custom'"/>
                            <field name="custom_interval_unit" invisible="frequency != 'custom'"/>
                            <field name="start_date"/>
                            <field name="next_date"/>
                        </group>
                        <group>
                            <field name="generation_mode"/>
                            <field name="generation_lead_days" invisible="generation_mode != 'draft'"/>
                            <field name="alert_days"/>
                        </group>
                    </group>
                    <group string="Control">
                        <field name="last_generated_for_date" readonly="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_payment_recurrence_calendar" model="ir.ui.view">
        <field name="name">soles.payment.recurrence.calendar</field>
        <field name="model">soles.payment.recurrence</field>
        <field name="arch" type="xml">
            <calendar string="Calendario de Pagos Recurrentes" date_start="next_date" color="partner_id" mode="month">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="estimated_amount"/>
                <field name="responsible_id"/>
            </calendar>
        </field>
    </record>

    <record id="action_payment_recurrences" model="ir.actions.act_window">
        <field name="name">Pagos Recurrentes</field>
        <field name="res_model">soles.payment.recurrence</field>
        <field name="view_mode">list,calendar,form</field>
    </record>

    <!-- Equipos -->
    <record id="view_treasury_team_list" model="ir.ui.view">
        <field name="name">soles.treasury.team.list</field>
        <field name="model">soles.treasury.team</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="manager_id"/>
                <field name="payment_schedule_summary"/>
                <field name="company_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_treasury_team_form" model="ir.ui.view">
        <field name="name">soles.treasury.team.form</field>
        <field name="model">soles.treasury.team</field>
        <field name="arch" type="xml">
            <form string="Equipo de Tesorería">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="company_id"/>
                        <field name="manager_id"/>
                        <field name="member_ids" widget="many2many_tags"/>
                        <field name="active"/>
                    </group>
                    <group><field name="description"/></group>
                    <group string="Fechas designadas para realizar pagos">
                        <field name="payment_schedule_line_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="schedule_type"/>
                                <field name="weekday" invisible="schedule_type != 'weekday'"/>
                                <field name="day_of_month" invisible="schedule_type != 'month_day'"/>
                                <field name="specific_date" invisible="schedule_type != 'specific'"/>
                                <field name="active"/>
                            </list>
                        </field>
                        <field name="payment_schedule_summary" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_treasury_teams" model="ir.actions.act_window">
        <field name="name">Equipos de Tesorería</field>
        <field name="res_model">soles.treasury.team</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Configuración -->
    <record id="view_treasury_config_form" model="ir.ui.view">
        <field name="name">soles.treasury.config.form</field>
        <field name="model">soles.treasury.config</field>
        <field name="arch" type="xml">
            <form string="Configuración de Tesorería">
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <field name="company_id"/>
                        <field name="default_team_id"/>
                    </group>
                    <group string="Integración con Aprobaciones">
                        <field name="approval_category_ids" widget="many2many_tags"/>
                    </group>
                    <group string="Alertas de pagos">
                        <field name="alert_day_1"/>
                        <field name="alert_day_2"/>
                        <field name="alert_day_3"/>
                        <field name="alert_on_due_date"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_treasury_config_list" model="ir.ui.view">
        <field name="name">soles.treasury.config.list</field>
        <field name="model">soles.treasury.config</field>
        <field name="arch" type="xml">
            <list>
                <field name="company_id"/>
                <field name="default_team_id"/>
            </list>
        </field>
    </record>

    <record id="action_treasury_config" model="ir.actions.act_window">
        <field name="name">Configuración</field>
        <field name="res_model">soles.treasury.config</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Integración con Aprobaciones -->
    <record id="view_approval_request_treasury" model="ir.ui.view">
        <field name="name">approval.request.form.treasury</field>
        <field name="model">approval.request</field>
        <field name="inherit_id" ref="approvals.approval_request_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_create_payment_request" string="Crear solicitud de pago" type="object"
                        class="btn-secondary" groups="soles_treasury.group_payment_request_user"
                        invisible="request_status != 'approved' or not treasury_payment_enabled"/>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <field name="treasury_payment_enabled" invisible="1"/>
            </xpath>
        </field>
    </record>

    <!-- Menús -->
    <menuitem id="menu_treasury_root" name="Tesorería" sequence="35"
              web_icon="soles_treasury,static/description/icon.png"
              groups="soles_treasury.group_payment_request_user"/>
    <menuitem id="menu_payment_requests" name="Solicitudes de Pago" parent="menu_treasury_root"
              action="action_payment_requests" sequence="10"/>
    <menuitem id="menu_my_payment_requests" name="Mis Solicitudes" parent="menu_treasury_root"
              action="action_my_payment_requests" sequence="20"/>
    <menuitem id="menu_payment_calendar" name="Calendario de Pagos" parent="menu_treasury_root"
              action="action_payment_calendar" sequence="30" groups="soles_treasury.group_treasury_user"/>
    <menuitem id="menu_payment_recurrences" name="Pagos Recurrentes" parent="menu_treasury_root"
              action="action_payment_recurrences" sequence="40" groups="soles_treasury.group_treasury_user"/>
    <menuitem id="menu_treasury_configuration_root" name="Configuración" parent="menu_treasury_root"
              sequence="90" groups="soles_treasury.group_treasury_manager"/>
    <menuitem id="menu_treasury_teams" name="Equipos de Tesorería" parent="menu_treasury_configuration_root"
              action="action_treasury_teams" sequence="10"/>
    <menuitem id="menu_treasury_config" name="Ajustes" parent="menu_treasury_configuration_root"
              action="action_treasury_config" sequence="20"/>
</odoo>
