<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_soles_autocancel_log_tree" model="ir.ui.view">
        <field name="name">soles.autocancel.log.tree</field>
        <field name="model">soles.autocancel.log</field>
        <field name="arch" type="xml">
            <list string="Historial de Cancelaciones Automáticas" create="false" edit="false">
                <field name="fecha_cancelacion"/>
                <field name="order_id"/>
                <field name="partner_id"/>
                <field name="dias_sin_facturar"/>
                <field name="estado" widget="badge"
                       decoration-success="estado == 'cancelado'"
                       decoration-info="estado == 'simulacion'"
                       decoration-danger="estado == 'error'"/>
                <field name="modo_prueba" optional="hide"/>
                <field name="detalle" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_soles_autocancel_log_form" model="ir.ui.view">
        <field name="name">soles.autocancel.log.form</field>
        <field name="model">soles.autocancel.log</field>
        <field name="arch" type="xml">
            <form string="Detalle de Autocancelación" create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="fecha_cancelacion"/>
                            <field name="order_id"/>
                            <field name="partner_id"/>
                        </group>
                        <group>
                            <field name="estado" widget="badge"/>
                            <field name="dias_sin_facturar"/>
                            <field name="modo_prueba"/>
                        </group>
                    </group>
                    <group string="Detalle">
                        <field name="detalle" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_soles_autocancel_log_search" model="ir.ui.view">
        <field name="name">soles.autocancel.log.search</field>
        <field name="model">soles.autocancel.log</field>
        <field name="arch" type="xml">
            <search string="Buscar en el historial">
                <field name="order_id"/>
                <field name="partner_id"/>
                <field name="estado"/>
                <filter string="Cancelados" name="solo_cancelados"
                        domain="[('estado', '=', 'cancelado')]"/>
                <filter string="Errores" name="solo_errores"
                        domain="[('estado', '=', 'error')]"/>
                <filter string="Simulaciones" name="solo_simulacion"
                        domain="[('estado', '=', 'simulacion')]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Cliente" name="group_partner"
                            context="{'group_by': 'partner_id'}"/>
                    <filter string="Resultado" name="group_estado"
                            context="{'group_by': 'estado'}"/>
                    <filter string="Fecha" name="group_fecha"
                            context="{'group_by': 'fecha_cancelacion:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_soles_autocancel_log" model="ir.actions.act_window">
        <field name="name">Historial de Cancelaciones Automáticas</field>
        <field name="res_model">soles.autocancel.log</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
