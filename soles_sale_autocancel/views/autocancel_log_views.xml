<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_soles_autocancel_log_tree" model="ir.ui.view">
        <field name="name">soles.autocancel.log.tree</field>
        <field name="model">soles.autocancel.log</field>
        <field name="arch" type="xml">
            <list string="Historial de Cancelaciones Automáticas" create="false" edit="false">
                <field name="fecha_cancelacion"/>
                <field name="order_id"/>
                <field name="partner_id"/>
                <field name="dias_sin_facturar"/>
                <field name="modo_prueba"/>
            </list>
        </field>
    </record>

    <record id="view_soles_autocancel_log_search" model="ir.ui.view">
        <field name="name">soles.autocancel.log.search</field>
        <field name="model">soles.autocancel.log</field>
        <field name="arch" type="xml">
            <search string="Buscar en el historial">
                <field name="order_id"/>
                <field name="partner_id"/>
                <filter string="Simulaciones" name="solo_simulacion"
                        domain="[('modo_prueba', '=', True)]"/>
                <filter string="Cancelaciones reales" name="solo_real"
                        domain="[('modo_prueba', '=', False)]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Cliente" name="group_partner"
                            context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_soles_autocancel_log" model="ir.actions.act_window">
        <field name="name">Historial de Cancelaciones Automáticas</field>
        <field name="res_model">soles.autocancel.log</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
