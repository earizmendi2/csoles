<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Categoría propia para que los permisos aparezcan claramente en el perfil del usuario. -->
    <record id="module_category_soles_autocancel" model="ir.module.category">
        <field name="name">Soles - Cancelación Automática</field>
        <field name="sequence">35</field>
    </record>

    <!-- Puede ver configuración y ejecutar el botón manual, pero no modificar parámetros. -->
    <record id="group_autocancel_manual" model="res.groups">
        <field name="name">Ejecutar cancelación manual</field>
        <field name="category_id" ref="module_category_soles_autocancel"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Permite ejecutar manualmente la autocancelación desde la configuración del módulo, sin modificar sus parámetros.</field>
    </record>

    <!-- Puede editar parámetros y, por implicación, también ejecutar manualmente. -->
    <record id="group_autocancel_admin" model="res.groups">
        <field name="name">Administrar autocancelación</field>
        <field name="category_id" ref="module_category_soles_autocancel"/>
        <field name="implied_ids" eval="[(4, ref('group_autocancel_manual'))]"/>
        <field name="comment">Permite modificar la configuración del módulo y ejecutar manualmente la autocancelación.</field>
    </record>

    <!-- Bootstrap seguro: quien ya administra Ajustes puede administrar este módulo.
         Después se puede delegar Ejecutar/Administrar desde el perfil de cada usuario. -->
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('soles_sale_autocancel.group_autocancel_admin'))]"/>
    </record>
</odoo>
