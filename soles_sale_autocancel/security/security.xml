<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Permisos independientes del rol comercial.
        Se ubican en "Otros permisos adicionales" para poder asignarlos
        directamente desde el perfil de cada usuario.
    -->
    <record id="group_autocancel_manual" model="res.groups">
        <field name="name">Autocancelación: ejecutar manualmente</field>
        <field name="category_id" ref="base.module_category_extra"/>
        <field name="comment">Permite ejecutar manualmente la cancelación de pedidos desde la configuración del módulo. No concede permisos de Gerente de Ventas ni permisos técnicos generales.</field>
    </record>

    <record id="group_autocancel_admin" model="res.groups">
        <field name="name">Autocancelación: administrar configuración</field>
        <field name="category_id" ref="base.module_category_extra"/>
        <field name="implied_ids" eval="[(4, ref('group_autocancel_manual'))]"/>
        <field name="comment">Permite modificar la configuración del módulo y también ejecutar manualmente la autocancelación.</field>
    </record>
</odoo>
