<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="group_profile_manager" model="res.groups">
            <field name="name">Profile Manager</field>
            <field name="comment">This group allows users to manage profiles and field access rules.</field>
        </record>

        <record id="ir_ui_menu_rule_profiles" model="ir.rule">
            <field name="name">Restrict Menu from Profiles</field>
            <field name="model_id" ref="base.model_ir_ui_menu"/>
            <field name="domain_force">[('id','not in', user._get_hide_menus())]</field>
        </record>
    </data>
</odoo>
